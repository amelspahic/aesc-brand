{
  "$schema": "./tokens.schema.json",
  "note": "Single source of truth. tokens.css is GENERATED from this file by build.mjs — edit this, never that.",
  "boja": {
    "zlato": {
      "hex": "#f6bf1f",
      "uloga": "The field. Panels, the primary action on dark, the mark's ground."
    },
    "zlato-duboko": {
      "hex": "#d9a30c",
      "uloga": "The same field after dark, and the pressed state of a gold control."
    },
    "mastilo": {
      "hex": "#17140d",
      "uloga": "Ink. A warm near-black."
    },
    "papir": {
      "hex": "#fbf8f1",
      "uloga": "Paper. Default ground for anything read at length."
    },
    "tinta": {
      "hex": "#0d4f47",
      "uloga": "Link ink and quiet emphasis on paper. Never a panel ground."
    },
    "tinta-polje": {
      "hex": "#033d36",
      "uloga": "The data field. Real published figures only."
    }
  },
  "dozvoljeno": [
    {
      "ink": "mastilo",
      "ground": "zlato",
      "min": 7,
      "zasto": "The signature pairing."
    },
    {
      "ink": "mastilo",
      "ground": "zlato-duboko",
      "min": 7,
      "zasto": "The gold field after dark."
    },
    {
      "ink": "zlato",
      "ground": "mastilo",
      "min": 7,
      "zasto": "Gold as ink, on ink only."
    },
    {
      "ink": "zlato",
      "ground": "tinta-polje",
      "min": 7,
      "zasto": "Figures on the data field."
    },
    {
      "ink": "mastilo",
      "ground": "papir",
      "min": 7,
      "zasto": "Running text."
    },
    {
      "ink": "papir",
      "ground": "mastilo",
      "min": 7,
      "zasto": "Inverted running text."
    },
    {
      "ink": "papir",
      "ground": "tinta-polje",
      "min": 7,
      "zasto": "Text on the data field."
    },
    {
      "ink": "tinta",
      "ground": "papir",
      "min": 7,
      "zasto": "Links."
    }
  ],
  "zabranjeno": [
    {
      "ink": "zlato",
      "ground": "papir",
      "zasto": "1.60:1. Gold is never ink on a light ground — not text, not a border, not a focus ring."
    }
  ],
  "pismo": {
    "prikaz": {
      "family": "Bricolage Grotesque",
      "google": "Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,400..800",
      "fallback": [
        "ui-sans-serif",
        "system-ui",
        "Segoe UI",
        "Helvetica",
        "Arial",
        "sans-serif"
      ],
      "uloga": "Headings, big figures, anything above 20px that is not running text."
    },
    "tijelo": {
      "family": "Archivo",
      "google": "Archivo:wght@400..700",
      "fallback": [
        "ui-sans-serif",
        "system-ui",
        "Segoe UI",
        "Helvetica",
        "Arial",
        "sans-serif"
      ],
      "uloga": "Every paragraph, button and label that is not a figure.",
      "napomena": "Do NOT request the wdth axis. Nothing sets a narrow Archivo and it costs 105.8 KB."
    },
    "podaci": {
      "family": "IBM Plex Mono",
      "google": "IBM+Plex+Mono:wght@400;500",
      "fallback": [
        "ui-monospace",
        "SFMono-Regular",
        "Menlo",
        "Consolas",
        "monospace"
      ],
      "uloga": "Figures, money, dates, phone numbers, IDs, chart labels, uppercase eyebrows."
    },
    "subsets": [
      "latin",
      "latin-ext"
    ],
    "napomena": "latin-ext is mandatory on all three. Without it č ć ž š đ fall back mid-word."
  },
  "velicine": {
    "mikro": {
      "css": "0.75rem",
      "px": "12"
    },
    "sitno": {
      "css": "0.8125rem",
      "px": "13"
    },
    "tijelo": {
      "css": "clamp(1rem, 0.979rem + 0.104vw, 1.063rem)",
      "px": "16 → 17"
    },
    "veliko": {
      "css": "clamp(1.125rem, 1.075rem + 0.25vw, 1.275rem)",
      "px": "18 → 20"
    },
    "uvod": {
      "css": "clamp(1.254rem, 1.163rem + 0.459vw, 1.53rem)",
      "px": "20 → 24"
    },
    "h3": {
      "css": "clamp(1.392rem, 1.209rem + 0.918vw, 1.943rem)",
      "px": "22 → 31",
      "wdth": 100
    },
    "h2-malo": {
      "css": "clamp(1.601rem, 1.299rem + 1.509vw, 2.507rem)",
      "px": "26 → 40"
    },
    "h2": {
      "css": "clamp(1.841rem, 1.369rem + 2.362vw, 3.259rem)",
      "px": "29 → 52",
      "wdth": 94
    },
    "h1": {
      "css": "clamp(2.062rem, 1.316rem + 3.732vw, 4.301rem)",
      "px": "33 → 69",
      "wdth": 90,
      "wght": 800
    },
    "hero": {
      "css": "clamp(2.3rem, 1.159rem + 5.702vw, 5.721rem)",
      "px": "37 → 92",
      "wdth": 88,
      "wght": 800
    },
    "brojka": {
      "css": "clamp(1.841rem, 1.369rem + 2.362vw, 3.259rem)",
      "px": "29 → 52",
      "napomena": "Tracks h2 deliberately. A figure and a section heading are the same weight of statement."
    }
  },
  "ritam": {
    "odjeljak": {
      "css": "clamp(3.5rem, 1.667rem + 9.167vw, 7rem)",
      "px": "56 → 112",
      "uloga": "Band padding."
    },
    "blok": {
      "css": "clamp(2rem, 1.333rem + 3.333vw, 3.25rem)",
      "px": "32 → 52",
      "uloga": "Between blocks in a band."
    },
    "red": {
      "css": "clamp(1.25rem, 1.083rem + 0.833vw, 1.75rem)",
      "px": "20 → 28",
      "uloga": "Between rows in a block."
    }
  },
  "pokret": {
    "ease-izlaz": "cubic-bezier(0.2, 0.7, 0.3, 1)",
    "ease-ulaz": "cubic-bezier(0.4, 0, 0.2, 1)",
    "stanje": "200ms",
    "brojac": "1100ms",
    "napomena": "Honour prefers-reduced-motion everywhere. A number still moving is a number nobody can check."
  },
  "mjere": {
    "mjera": {
      "css": "34em",
      "uloga": "Reading measure. ~66 characters. Never `ch` — it measures the zero glyph."
    },
    "okvir": {
      "css": "74rem",
      "uloga": "Container max width."
    }
  },
  "napomena": "Single source of truth. tokens.css (plain :root) and tokens.theme.css (a Tailwind @theme block) are BOTH generated from this file by build.mjs — edit this, never those."
}
